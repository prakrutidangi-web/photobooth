# Supabase: Project Settings > API. The anon key is meant to be public; NEVER put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Your public site URL (used for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: Google AdSense publisher id (ca-pub-...). Leave empty to disable ads.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=
# Set to true ONLY after enabling the Google provider in Supabase
NEXT_PUBLIC_GOOGLE_ENABLED=false
